{
    "name": "ahmadfadlydziljalal/yii2-dynamicform-v2",
    "description": "It is widget to yii2 framework to clone form elements in a nested manner, maintaining accessibility. (Dzil Fork)",
    "keywords": [
        "wbraganca",
        "yii2",
        "extension",
        "widget",
        "yii2-dynamicform",
        "copy DOM element",
        "yii2 dynamic form",
        "Dev Dev Dzil"
    ],
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/ahmadfadlydziljalal/yii2-dynamicform/issues",
        "source": "https://github.com/ahmadfadlydziljalal/yii2-dynamicform"
    },
    "authors": [
        {
            "name": "Wanderson Bragança",
            "email": "wanderson.wbc@gmail.com",
            "homepage": "http://wbraganca.com"
        },
        {
            "name": "Ahmad Fadly Dziljalal",
            "email": "ahmadfadlydziljalal@gmail.com"
        }
    ],
    "require": {
        "yiisoft/yii2": "~2.0.5",
        "symfony/css-selector": "*",
        "symfony/dom-crawler": "*"
    },
    "autoload": {
        "psr-4": {
            "wbraganca\\dynamicform\\": "src"
        }
    }
